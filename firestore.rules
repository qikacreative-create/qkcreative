rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    
    function getTimDoc(uid) {
      return get(/databases/$(database)/documents/tim_studio/$(uid));
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isAdmin(ownerId) {
      return isSignedIn() && getTimDoc(request.auth.uid).data.ownerParentId == ownerId && getTimDoc(request.auth.uid).data.role == 'admin';
    }

    function isStaff(ownerId) {
      return isSignedIn() && getTimDoc(request.auth.uid).data.ownerParentId == ownerId && getTimDoc(request.auth.uid).data.role == 'anggota';
    }

    // --- Rules ---

    // 1. Indeks peran staf (hanya bisa diakses sistem/user terkait)
    match /tim_studio/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || getTimDoc(request.auth.uid).data.role == 'admin');
      allow write: if false; // Hanya melalui backend/server
    }

    // 2. Data Owner
    match /owners/{ownerId} {
      allow read: if isOwner(ownerId) || isAdmin(ownerId) || isStaff(ownerId);
      allow write: if isOwner(ownerId);
      
      // Sub-koleksi
      match /tim/{staffId} {
        allow read: if isOwner(ownerId) || isAdmin(ownerId);
        allow write: if isOwner(ownerId);
      }
      
      match /jadwal/{jadwalId} {
        allow read: if isOwner(ownerId) || isAdmin(ownerId) || isStaff(ownerId);
        allow write: if isOwner(ownerId) || isAdmin(ownerId);
      }
      
      match /paket_layanan/{paketId} {
        allow read: if isOwner(ownerId) || isAdmin(ownerId) || isStaff(ownerId);
        allow write: if isOwner(ownerId);
      }
      
      match /pengaturan/{pengaturanId} {
        allow read: if isOwner(ownerId) || isAdmin(ownerId);
        allow write: if isOwner(ownerId);
      }
      
      match /arsip_kompresi/{arsipId} {
        allow read: if isOwner(ownerId) || isAdmin(ownerId);
        allow write: if isOwner(ownerId);
      }
    }
  }
}
